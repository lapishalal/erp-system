    {{-- Chart.js Scripts --}}
    @push('scripts')
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Common chart defaults
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.color = '#6b7280';

        // Revenue Trend Chart
        const revenueCtx = document.getElementById('revenueTrendChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: @json($this->getRevenueTrendData()['labels']),
                datasets: [{
                    label: 'Pendapatan',
                    data: @json($this->getRevenueTrendData()['data']),
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 3,
                    pointHoverRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Rp ' + context.parsed.y.toLocaleString('id-ID');
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return 'Rp ' + (value / 1000000).toFixed(1) + 'M';
                            }
                        }
                    }
                }
            }
        });

        // Sales by Channel Chart
        const channelCtx = document.getElementById('salesByChannelChart').getContext('2d');
        new Chart(channelCtx, {
            type: 'doughnut',
            data: {
                labels: @json($this->getSalesByChannelData()['labels']),
                datasets: [{
                    data: @json($this->getSalesByChannelData()['data']),
                    backgroundColor: [
                        '#10b981', '#ef4444', '#f59e0b', '#3b82f6', '#8b5cf6'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const value = context.parsed;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((value / total) * 100).toFixed(1);
                                return context.label + ': Rp ' + value.toLocaleString('id-ID') + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });

        // Top Products Chart
        const productsCtx = document.getElementById('topProductsChart').getContext('2d');
        new Chart(productsCtx, {
            type: 'bar',
            data: {
                labels: @json($this->getTopProductsData()['labels']),
                datasets: [{
                    label: 'Revenue',
                    data: @json($this->getTopProductsData()['data']),
                    backgroundColor: '#f59e0b',
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Rp ' + context.parsed.x.toLocaleString('id-ID');
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            callback: function(value) {
                                return 'Rp ' + (value / 1000000).toFixed(1) + 'M';
                            }
                        }
                    }
                }
            }
        });

        // Monthly Comparison Chart
        const comparisonCtx = document.getElementById('monthlyComparisonChart').getContext('2d');
        new Chart(comparisonCtx, {
            type: 'bar',
            data: {
                labels: @json($this->getMonthlyComparisonData()['labels']),
                datasets: [
                    {
                        label: '{{ now()->year }}',
                        data: @json($this->getMonthlyComparisonData()['this_year']),
                        backgroundColor: '#3b82f6',
                        borderRadius: 4
                    },
                    {
                        label: '{{ now()->year - 1 }}',
                        data: @json($this->getMonthlyComparisonData()['last_year']),
                        backgroundColor: '#9ca3af',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': Rp ' + context.parsed.y.toLocaleString('id-ID');
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return 'Rp ' + (value / 1000000).toFixed(1) + 'M';
                            }
                        }
                    }
                }
            }
        });

        // AR Aging Chart
        const agingCtx = document.getElementById('arAgingChart').getContext('2d');
        const agingData = @json($this->getArAgingData());
        new Chart(agingCtx, {
            type: 'bar',
            data: {
                labels: ['Current', '1-30', '31-60', '61-90', '>90'],
                datasets: [{
                    label: 'Piutang',
                    data: [agingData.current, agingData['1_30'], agingData['31_60'], agingData['61_90'], agingData.above_90],
                    backgroundColor: [
                        '#10b981', '#3b82f6', '#f59e0b', '#f97316', '#ef4444'
                    ],
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Rp ' + context.parsed.y.toLocaleString('id-ID');
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return 'Rp ' + (value / 1000000).toFixed(1) + 'M';
                            }
                        }
                    }
                }
            }
        });

        // Expense Breakdown Chart
        const expenseCtx = document.getElementById('expenseBreakdownChart').getContext('2d');
        new Chart(expenseCtx, {
            type: 'pie',
            data: {
                labels: @json($this->getExpenseBreakdownData()['labels']),
                datasets: [{
                    data: @json($this->getExpenseBreakdownData()['data']),
                    backgroundColor: [
                        '#ef4444', '#f59e0b', '#10b981', '#3b82f6', '#8b5cf6', '#ec4899', '#14b8a6'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const value = context.parsed;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((value / total) * 100).toFixed(1);
                                return context.label + ': Rp ' + value.toLocaleString('id-ID') + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });
    </script>
    @endpush

    {{-- Custom Styles --}}
    @styles
    <style>
        canvas {
            max-height: 300px;
        }
        .bg-info-500 {
            background-color: #0ea5e9;
        }
        .bg-info-600 {
            background-color: #0284c7;
        }
        .text-info-500 {
            color: #0ea5e9;
        }
    </style>
    @endstyles
</x-filament-panels::page>