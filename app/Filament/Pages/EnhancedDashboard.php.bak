<?php

namespace App\Filament\Pages;

use App\Models\SalesOrder;
use App\Models\PurchaseOrder;
use App\Models\SalesInvoice;
use App\Models\PurchaseInvoice;
use App\Models\CashIn;
use App\Models\CashOut;
use App\Models\DeliveryOrder;
use App\Models\MarketplaceOrder;
use App\Models\Product;
use App\Models\ProductStock;
use App\Models\Customer;
use App\Models\Supplier;
use App\Models\Account;
use App\Models\JournalEntry;
use App\Models\JournalEntryDetail;
use App\Models\AccountBalance;
use Filament\Pages\Page;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Auth;
use Carbon\Carbon;

class EnhancedDashboard extends Page
{
    protected static ?string $navigationIcon = 'heroicon-o-chart-bar';
    protected static ?string $navigationLabel = 'Dashboard Analitik';
    protected static ?string $title = 'Dashboard Analitik Bisnis';
    protected static ?string $slug = 'enhanced-dashboard';
    protected static ?int $navigationSort = 1;
    protected static ?string $navigationGroup = 'Dasbor';

    protected static string $view = 'filament.pages.enhanced-dashboard';

    public static function shouldRegisterNavigation(): bool
    {
        return auth()->check() && auth()->user()->hasRole('Admin');
    }

    /**
     * Get comprehensive stats for dashboard cards
     */
    public function getStatsCards(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return [];
        }

        $today = now()->startOfDay();
        $yesterday = now()->subDay()->startOfDay();
        $startOfMonth = now()->startOfMonth();
        $startOfLastMonth = now()->subMonth()->startOfMonth();

        // === FINANCIAL METRICS ===

        // Cash Position (Total Kas & Bank)
        $cashAccounts = Account::where('tenant_id', $tenantId)
            ->whereIn('code', ['1-10001', '1-10002']) // Kas & Bank
            ->pluck('id');

        $cashPosition = 0;
        try {
            $cashPosition = JournalEntryDetail::whereIn('account_id', $cashAccounts)
                ->whereHas('journalEntry', fn($q) => $q->where('tenant_id', $tenantId))
                ->selectRaw('SUM(debit - credit) as balance')
                ->value('balance') ?? 0;
        } catch (\Exception $e) {
            $cashPosition = 0;
        }

        // Revenue Today
        $revenueToday = SalesInvoice::where('tenant_id', $tenantId)
            ->whereDate('date', $today)
            ->sum('total');

        // Revenue Yesterday (for comparison)
        $revenueYesterday = SalesInvoice::where('tenant_id', $tenantId)
            ->whereDate('date', $yesterday)
            ->sum('total');

        // Revenue MTD (Month to Date)
        $revenueMTD = SalesInvoice::where('tenant_id', $tenantId)
            ->whereDate('date', '>=', $startOfMonth)
            ->sum('total');

        // Revenue Last Month (for comparison)
        $revenueLastMonth = SalesInvoice::where('tenant_id', $tenantId)
            ->whereBetween('date', [$startOfLastMonth, now()->startOfMonth()->subDay()])
            ->sum('total');

        // Accounts Receivable (Piutang)
        $arAccount = Account::where('tenant_id', $tenantId)
            ->where('code', '1-10003') // Piutang Usaha
            ->first();

        $accountsReceivable = 0;
        if ($arAccount) {
            try {
                $accountsReceivable = JournalEntryDetail::where('account_id', $arAccount->id)
                    ->whereHas('journalEntry', fn($q) => $q->where('tenant_id', $tenantId))
                    ->selectRaw('SUM(debit - credit) as balance')
                    ->value('balance') ?? 0;
            } catch (\Exception $e) {
                $accountsReceivable = 0;
            }
        }

        // Accounts Payable (Hutang)
        $apAccount = Account::where('tenant_id', $tenantId)
            ->where('code', '2-10001') // Hutang Usaha
            ->first();

        $accountsPayable = 0;
        if ($apAccount) {
            try {
                $accountsPayable = JournalEntryDetail::where('account_id', $apAccount->id)
                    ->whereHas('journalEntry', fn($q) => $q->where('tenant_id', $tenantId))
                    ->selectRaw('SUM(credit - debit) as balance')
                    ->value('balance') ?? 0;
            } catch (\Exception $e) {
                $accountsPayable = 0;
            }
        }

        // === SALES METRICS ===

        // Sales Orders Today
        $salesOrdersToday = SalesOrder::where('tenant_id', $tenantId)
            ->whereDate('date', $today)
            ->count();

        // Sales Orders Pending
        $salesOrdersPending = SalesOrder::where('tenant_id', $tenantId)
            ->whereIn('status', ['CONFIRMED', 'PROCESSING'])
            ->count();

        // Delivery Orders Today
        $deliveryOrdersToday = DeliveryOrder::where('tenant_id', $tenantId)
            ->whereDate('date', $today)
            ->count();

        // === INVENTORY METRICS ===

        // Total Stock Value
        $stockValue = DB::table('product_stocks')
            ->join('products', 'product_stocks.product_id', '=', 'products.id')
            ->where('product_stocks.tenant_id', $tenantId)
            ->selectRaw('SUM(product_stocks.available_stock * products.last_buy_price) as total_value')
            ->value('total_value') ?? 0;

        // Critical Stock Items (< min_stock)
        $criticalStockItems = ProductStock::where('tenant_id', $tenantId)
            ->join('products', 'product_stocks.product_id', '=', 'products.id')
            ->whereColumn('product_stocks.available_stock', '<', 'products.min_stock')
            ->count();

        // Low Stock Items (< 10 units)
        $lowStockItems = ProductStock::where('tenant_id', $tenantId)
            ->where('available_stock', '<', 10)
            ->count();

        // === MARKETPLACE METRICS ===

        // Pending Marketplace Orders
        $pendingMarketplace = MarketplaceOrder::where('tenant_id', $tenantId)
            ->whereNull('sales_order_id')
            ->count();

        // Unmapped Orders (skip if table doesn't exist)
        $unmappedOrders = 0;
        try {
            $unmappedOrders = MarketplaceOrder::where('tenant_id', $tenantId)
                ->where('is_mapped', false)
                ->count();
        } catch (\Exception $e) {
            // Table marketplace_order_items may not exist yet
            $unmappedOrders = 0;
        }

        // === PURCHASE METRICS ===

        // Purchase Orders Pending Approval
        $poPendingApproval = PurchaseOrder::where('tenant_id', $tenantId)
            ->where('status', 'PENDING')
            ->count();

        // Calculate trends
        $revenueTrend = $revenueYesterday > 0 ? (($revenueToday - $revenueYesterday) / $revenueYesterday) * 100 : 0;
        $mtdTrend = $revenueLastMonth > 0 ? (($revenueMTD - $revenueLastMonth) / $revenueLastMonth) * 100 : 0;

        return [
            // Financial
            'cash_position' => max(0, $cashPosition),
            'revenue_today' => $revenueToday,
            'revenue_yesterday' => $revenueYesterday,
            'revenue_trend' => round($revenueTrend, 1),
            'revenue_mtd' => $revenueMTD,
            'revenue_last_month' => $revenueLastMonth,
            'mtd_trend' => round($mtdTrend, 1),
            'accounts_receivable' => max(0, $accountsReceivable),
            'accounts_payable' => max(0, $accountsPayable),

            // Sales
            'sales_orders_today' => $salesOrdersToday,
            'sales_orders_pending' => $salesOrdersPending,
            'delivery_orders_today' => $deliveryOrdersToday,

            // Inventory
            'stock_value' => $stockValue,
            'critical_stock_items' => $criticalStockItems,
            'low_stock_items' => $lowStockItems,

            // Marketplace
            'pending_marketplace' => $pendingMarketplace,
            'unmapped_orders' => $unmappedOrders,

            // Purchase
            'po_pending_approval' => $poPendingApproval,
        ];
    }

    /**
     * Revenue trend for the last 30 days
     */
    public function getRevenueTrendData(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return ['labels' => [], 'data' => []];
        }

        $revenueData = SalesInvoice::where('tenant_id', $tenantId)
            ->whereDate('date', '>=', now()->subDays(30))
            ->selectRaw('DATE(date) as date, SUM(total) as revenue')
            ->groupBy('date')
            ->orderBy('date')
            ->get();

        $labels = [];
        $data = [];

        for ($i = 29; $i >= 0; $i--) {
            $date = now()->subDays($i)->format('Y-m-d');
            $labels[] = now()->parse($date)->format('d M');

            $revenue = $revenueData->firstWhere('date', $date)?->revenue ?? 0;
            $data[] = (float) $revenue;
        }

        return ['labels' => $labels, 'data' => $data];
    }

    /**
     * Sales by channel for current month
     */
    public function getSalesByChannelData(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return ['labels' => [], 'data' => []];
        }

        $salesBySource = SalesOrder::where('tenant_id', $tenantId)
            ->whereMonth('date', now()->month)
            ->whereYear('date', now()->year)
            ->select('source', DB::raw('SUM(total_amount) as total'))
            ->groupBy('source')
            ->get();

        $labels = $salesBySource->pluck('source')->map(fn($s) => ucfirst($s))->toArray();
        $data = $salesBySource->pluck('total')->map(fn($t) => (float) $t)->toArray();

        return ['labels' => $labels, 'data' => $data];
    }

    /**
     * Top 10 products by revenue this month
     */
    public function getTopProductsData(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return ['labels' => [], 'data' => []];
        }

        $topProducts = DB::table('sales_order_details')
            ->join('sales_orders', 'sales_order_details.so_id', '=', 'sales_orders.id')
            ->join('products', 'sales_order_details.product_id', '=', 'products.id')
            ->where('sales_orders.tenant_id', $tenantId)
            ->whereMonth('sales_orders.date', now()->month)
            ->whereYear('sales_orders.date', now()->year)
            ->select('products.name', DB::raw('SUM(sales_order_details.qty * sales_order_details.price) as revenue'))
            ->groupBy('products.id', 'products.name')
            ->orderByDesc('revenue')
            ->limit(10)
            ->get();

        return [
            'labels' => $topProducts->pluck('name')->toArray(),
            'data' => $topProducts->pluck('revenue')->map(fn($r) => (float) $r)->toArray(),
        ];
    }

    /**
     * AR Aging Summary
     */
    public function getArAgingData(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return [];
        }

        $now = now();
        $invoices = SalesInvoice::where('tenant_id', $tenantId)
            ->where('status', '!=', 'PAID')
            ->where('total', '>', DB::raw('paid_amount'))
            ->with('customer')
            ->get();

        $aging = [
            'current' => 0,
            '1_30' => 0,
            '31_60' => 0,
            '61_90' => 0,
            'above_90' => 0,
        ];

        foreach ($invoices as $invoice) {
            $overdue = $invoice->due_date->diffInDays($now);
            $outstanding = $invoice->total - $invoice->paid_amount;

            if ($overdue < 0) {
                $aging['current'] += $outstanding;
            } elseif ($overdue <= 30) {
                $aging['1_30'] += $outstanding;
            } elseif ($overdue <= 60) {
                $aging['31_60'] += $outstanding;
            } elseif ($overdue <= 90) {
                $aging['61_90'] += $outstanding;
            } else {
                $aging['above_90'] += $outstanding;
            }
        }

        return $aging;
    }

    /**
     * Upcoming payments due in next 7 days
     */
    public function getUpcomingPayments(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return [];
        }

        $upcomingAR = [];
        try {
            $upcomingAR = SalesInvoice::where('tenant_id', $tenantId)
                ->where('status', '!=', 'PAID')
                ->whereBetween('due_date', [now(), now()->addDays(7)])
                ->with('customer')
                ->orderBy('due_date')
                ->limit(5)
                ->get();
        } catch (\Exception $e) {
            return [];
        }

        return $upcomingAR->map(fn($inv) => [
            'type' => 'receivable',
            'number' => $inv->invoice_number,
            'party' => $inv->customer?->name ?? 'N/A',
            'amount' => $inv->total - $inv->paid_amount,
            'due_date' => $inv->due_date->format('d M Y'),
            'days_left' => max(0, now()->diffInDays($inv->due_date)),
        ])->toArray();
    }

    /**
     * Monthly sales comparison (this year vs last year)
     */
    public function getMonthlyComparisonData(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return ['labels' => [], 'this_year' => [], 'last_year' => []];
        }

        $thisYear = SalesInvoice::where('tenant_id', $tenantId)
            ->whereYear('date', now()->year)
            ->selectRaw('MONTH(date) as month, SUM(total) as revenue')
            ->groupBy('month')
            ->pluck('revenue', 'month');

        $lastYear = SalesInvoice::where('tenant_id', $tenantId)
            ->whereYear('date', now()->year - 1)
            ->selectRaw('MONTH(date) as month, SUM(total) as revenue')
            ->groupBy('month')
            ->pluck('revenue', 'month');

        $labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        $thisYearData = [];
        $lastYearData = [];

        for ($i = 1; $i <= 12; $i++) {
            $thisYearData[] = (float) ($thisYear[$i] ?? 0);
            $lastYearData[] = (float) ($lastYear[$i] ?? 0);
        }

        return [
            'labels' => $labels,
            'this_year' => $thisYearData,
            'last_year' => $lastYearData,
        ];
    }

    /**
     * Expense breakdown by category this month
     */
    public function getExpenseBreakdownData(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return ['labels' => [], 'data' => []];
        }

        $expenses = [];
        try {
            $expenses = CashOut::where('tenant_id', $tenantId)
                ->whereMonth('date', now()->month)
                ->whereYear('date', now()->year)
                ->join('expense_categories', 'cash_out.category_id', '=', 'expense_categories.id')
                ->select('expense_categories.name', DB::raw('SUM(cash_out.amount) as total'))
                ->groupBy('expense_categories.id', 'expense_categories.name')
                ->get();
        } catch (\Exception $e) {
            // expense_categories table may not exist yet
            return ['labels' => [], 'data' => []];
        }

        return [
            'labels' => $expenses->pluck('name')->toArray(),
            'data' => $expenses->pluck('total')->map(fn($t) => (float) $t)->toArray(),
        ];
    }

    /**
     * Recent high-value transactions
     */
    public function getRecentTransactions(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return [];
        }

        $cashIns = CashIn::where('tenant_id', $tenantId)
            ->where('amount', '>=', 1000000)
            ->orderBy('created_at', 'desc')
            ->limit(5)
            ->get()
            ->map(fn($ci) => [
                'type' => 'income',
                'date' => $ci->date->format('d M Y'),
                'description' => $ci->description ?? $ci->type,
                'amount' => $ci->amount,
            ]);

        $cashOuts = CashOut::where('tenant_id', $tenantId)
            ->where('amount', '>=', 1000000)
            ->orderBy('created_at', 'desc')
            ->limit(5)
            ->get()
            ->map(fn($co) => [
                'type' => 'expense',
                'date' => $co->date->format('d M Y'),
                'description' => $co->description ?? $co->category?->name ?? 'Cash Out',
                'amount' => $co->amount,
            ]);

        $combined = $cashIns->merge($cashOuts)
            ->sortByDesc('date')
            ->take(10)
            ->values();

        return $combined->toArray();
    }

    /**
     * Low stock products with reorder suggestion
     */
    public function getLowStockProducts(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return [];
        }

        $lowStock = ProductStock::where('tenant_id', $tenantId)
            ->join('products', 'product_stocks.product_id', '=', 'products.id')
            ->whereColumn('product_stocks.available_stock', '<=', 'products.min_stock')
            ->select(
                'products.id',
                'products.name',
                'products.code',
                'products.min_stock',
                'product_stocks.available_stock',
                DB::raw('products.min_stock - product_stocks.available_stock as shortage')
            )
            ->orderBy('shortage', 'desc')
            ->limit(10)
            ->get();

        return $lowStock->toArray();
    }

    /**
     * Purchase orders pending approval
     */
    public function getPendingPOs(): array
    {
        $tenantId = auth()->user()->tenant_id ?? session('tenant_id');

        if (!$tenantId) {
            return [];
        }

        $pendingPOs = PurchaseOrder::where('tenant_id', $tenantId)
            ->where('status', 'PENDING')
            ->with('supplier')
            ->orderBy('created_at', 'desc')
            ->limit(5)
            ->get();

        return $pendingPOs->map(fn($po) => [
            'id' => $po->id,
            'number' => $po->po_number,
            'supplier' => $po->supplier?->name ?? 'N/A',
            'total' => $po->total_amount,
            'date' => $po->date->format('d M Y'),
        ])->toArray();
    }
}